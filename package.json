{
  "name": "bet-and-basleal",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c green,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @basleal/web",
    "dev:api": "npm run dev --workspace @basleal/api",
    "build": "npm run build --workspaces --if-present",
    "start:web": "npm run start --workspace @basleal/web",
    "start:api": "npm run start --workspace @basleal/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
